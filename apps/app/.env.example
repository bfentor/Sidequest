# Copy to .env.local. Where the Django backend is reachable from the device:
#   iOS simulator / web: http://localhost:8000
#   Android emulator:    http://10.0.2.2:8000
#   Physical device:     http://<your computer's LAN IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Where the web app runs; links people share point here.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Store pages, linked from the web landing page once the app is published (leave empty until then).
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
