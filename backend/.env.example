# Copy to .env for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgis://sidequest:sidequest@localhost:5432/sidequest
# Origins allowed to call the API from a browser (the Expo web dev server).
CORS_ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_URL=http://localhost:8081
API_URL=http://localhost:8000
# New accounts verify their email with a code, printed in the runserver output
# while no email service is set up. Uncomment to skip it while developing:
# ACCOUNT_EMAIL_VERIFICATION=optional
