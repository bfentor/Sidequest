msgid "Accept the terms of service and privacy policy to continue."
msgstr "Godkänn användarvillkoren och integritetspolicyn för att fortsätta."

#, python-format
msgid "You need to be at least %(age)s years old to use Sidequest."
msgstr "Du måste vara minst %(age)s år för att använda Sidequest."

msgid "The password is wrong."
msgstr "Lösenordet är fel."

#, python-format
msgid "No profile has the username %(handle)s."
msgstr "Ingen profil har användarnamnet %(handle)s."

msgid "Must be after the start time."
msgstr "Måste vara efter starttiden."

msgid "This event was cancelled."
msgstr "Evenemanget är inställt."

#, python-format
msgid "This event is for %(university)s students. Verify you study there in Settings."
msgstr "Evenemanget är för studenter vid %(university)s. Bekräfta att du studerar där i inställningarna."

msgid "Add your birth date in Settings to join this event."
msgstr "Lägg till ditt födelsedatum i inställningarna för att delta i evenemanget."

#, python-format
msgid "This event is for people aged %(age)s or over."
msgstr "Evenemanget är för personer som fyllt %(age)s år."

msgid "This profile wasn't invited to co-host."
msgstr "Den här profilen bjöds inte in som medarrangör."

msgid "The picture is too large (at most 10 MB)."
msgstr "Bilden är för stor (högst 10 MB)."

msgid "Spam"
msgstr "Skräppost"

msgid "Harassment or bullying"
msgstr "Trakasserier eller mobbning"

msgid "Hate speech"
msgstr "Hatpropaganda"

msgid "Nudity or sexual content"
msgstr "Nakenhet eller sexuellt innehåll"

msgid "Violence or dangerous activity"
msgstr "Våld eller farlig verksamhet"

msgid "False information"
msgstr "Falsk information"

msgid "Something else"
msgstr "Något annat"

msgid "Open"
msgstr "Öppen"

msgid "Resolved"
msgstr "Löst"

msgid "Dismissed"
msgstr "Avvisad"

msgid "Removed content"
msgstr "Tog bort innehåll"

msgid "Restored content"
msgstr "Återställde innehåll"

msgid "Dismissed reports"
msgstr "Avvisade anmälningar"

msgid "This content no longer exists."
msgstr "Det här innehållet finns inte längre."

msgid "You cannot block yourself."
msgstr "Du kan inte blockera dig själv."

msgid "You cannot mute yourself."
msgstr "Du kan inte tysta dig själv."

msgid "New followers"
msgstr "Nya följare"

msgid "Follow requests"
msgstr "Följarförfrågningar"

msgid "Accepted follow requests"
msgstr "Godkända följarförfrågningar"

msgid "Invitations to organizations"
msgstr "Inbjudningar till organisationer"

msgid "New events from people you follow"
msgstr "Nya evenemang från dem du följer"

msgid "Changes to events you're going to"
msgstr "Ändringar i evenemang du ska gå på"

msgid "Cancelled events"
msgstr "Inställda evenemang"

msgid "Postponed events"
msgstr "Uppskjutna evenemang"

msgid "Invitations to co-host events"
msgstr "Inbjudningar att arrangera evenemang tillsammans"

msgid "Event reminders"
msgstr "Påminnelser om evenemang"

msgid "A spot opened up for you"
msgstr "En plats blev ledig åt dig"

msgid "Announcements from organizers"
msgstr "Meddelanden från arrangörer"

msgid "Mentions"
msgstr "Omnämnanden"

msgid "Comments"
msgstr "Kommentarer"

msgid "Likes"
msgstr "Gilla-markeringar"

#, python-format
msgid "%(name)s started following you."
msgstr "%(name)s började följa dig."

#, python-format
msgid "%(name)s asked to follow you."
msgstr "%(name)s vill följa dig."

#, python-format
msgid "%(name)s invited you to join them."
msgstr "%(name)s bjöd in dig som medlem."

#, python-format
msgid "%(name)s accepted your follow request."
msgstr "%(name)s godkände din följarförfrågan."

#, python-format
msgid "New event from %(name)s."
msgstr "Nytt evenemang från %(name)s."

msgid "The time or place of this event changed."
msgstr "Tiden eller platsen för evenemanget har ändrats."

msgid "This event was postponed."
msgstr "Evenemanget har skjutits upp."

#, python-format
msgid "%(name)s invited you to co-host this event."
msgstr "%(name)s bjöd in dig att arrangera evenemanget tillsammans."

#, python-format
msgid "Starts at %(time)s."
msgstr "Börjar kl. %(time)s."

msgid "A spot opened up: you're going!"
msgstr "En plats blev ledig: du kommer!"

#, python-format
msgid "%(name)s mentioned you."
msgstr "%(name)s nämnde dig."

#, python-format
msgid "%(name)s commented."
msgstr "%(name)s kommenterade."

#, python-format
msgid "%(name)s liked your post."
msgstr "%(name)s gillade ditt inlägg."

msgid "Your birth date is already set."
msgstr "Ditt födelsedatum är redan angivet."

msgid "A post needs a body, an event, or both."
msgstr "Ett inlägg behöver text, ett evenemang eller båda."

msgid "Use only lowercase letters, numbers and underscores."
msgstr "Använd bara små bokstäver, siffror och understreck."

msgid "Enter an Instagram username without the @."
msgstr "Ange ett Instagram-användarnamn utan @."

msgid "Pending"
msgstr "Väntar"

msgid "Approved"
msgstr "Godkänd"

msgid "Rejected"
msgstr "Avslagen"

msgid "Only the organization's admins can do this."
msgstr "Bara organisationens administratörer kan göra det här."

msgid "No person has this username."
msgstr "Ingen person har det här användarnamnet."

msgid "They are already a member."
msgstr "Hen är redan medlem."

msgid "This organization is already verified."
msgstr "Organisationen är redan verifierad."

msgid "An organization needs at least one admin."
msgstr "En organisation behöver minst en administratör."

msgid "You cannot follow yourself."
msgstr "Du kan inte följa dig själv."

msgid "Unblock this profile to follow it."
msgstr "Häv blockeringen av profilen för att följa den."

msgid "This profile's followers are hidden."
msgstr "Den här profilens följare är dolda."

msgid "Use upcoming or past."
msgstr "Använd upcoming eller past."

msgid "This isn't a university email address we know."
msgstr "Det här är inte en universitetsadress som vi känner till."

msgid "[Sidequest] Your student verification code"
msgstr "[Sidequest] Din kod för studentverifiering"

#, python-format
msgid "Your code is %(code)s. Enter it in Sidequest within 15 minutes to show you study at %(university)s. If you didn't ask for this, ignore this email."
msgstr "Din kod är %(code)s. Ange den i Sidequest inom 15 minuter för att visa att du studerar vid %(university)s. Om du inte bad om det här kan du ignorera mejlet."

msgid "The code has expired. Ask for a new one."
msgstr "Koden har gått ut. Be om en ny."

msgid "Too many wrong codes. Ask for a new one."
msgstr "För många felaktiga koder. Be om en ny."

msgid "The code is wrong."
msgstr "Koden är fel."

#~ msgid "Choose admin or editor."
#~ msgstr "Välj administratör eller redaktör."
